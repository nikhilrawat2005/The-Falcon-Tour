# ============================================================
# The Falcon Tour - Apache/.htaccess security & caching headers
# Applies when the site is served by Apache or cPanel hosting.
# (Netlify/Cloudflare Pages hosts: the _headers file covers this.)
# ============================================================

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Force HTTPS (redirect all HTTP -> HTTPS)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Long-term caching for immutable static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 day"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Gzip/Brotli compression for faster TTFB
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# Block access to hidden/internal files
<FilesMatch "^(skills-lock\.json|firestore\.rules)$">
  Require all denied
</FilesMatch>

# URL Rewrite Rules
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^destination-(.+)\.html$ /destinations/destination-$1.html [L,R=301]
  RewriteRule ^activity-(.+)\.html$ /activities/activity-$1.html [L,R=301]
  RewriteRule ^trip-(.+)\.html$ /packages/trip-$1.html [L,R=301]
</IfModule>

# Default document
DirectoryIndex index.html
